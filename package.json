{
  "name": "component-library",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:icons": "pnpm --filter @borderline-ui/icons build",
    "build:ui": "pnpm --filter @borderline-ui/ui build",
    "build:demo": "pnpm --filter demo build",
    "dev:demo": "pnpm --filter demo dev",
    "storybook": "pnpm --filter storybook dev",
    "build-storybook": "pnpm --filter storybook build",
    "test": "pnpm build:icons && pnpm test:ui --run",
    "test:ui": "pnpm --filter @borderline-ui/ui test:browser",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "release": "pnpm --filter \"@borderline-ui/*\" publish --no-git-checks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "typescript": "~7.0.2"
  }
}
